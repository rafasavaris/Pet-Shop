<link rel="stylesheet" href="/css/style.css">

<section class="widget">
    <h1>Agenda do Pet Shop!</h1>

    <table>
        <thead>
            <th>Data</th>
            <th>Horário</th>
            <th>Cliente</th>
            <th>Telefone</th>
            <th>Endereço</th>
            <th>Nome do Pet</th>
            <th>Serviço</th>
        </thead>

        <tbody>
            {{{#each agendamentos}}}
            <tr>
                <td>{{data}}</td>
                <td>{{hora}}</td>
                <td>{{nome}}</td>
                <td>{{telefone}}</td>
                <td>{{endereco}}</td>
                <td>{{nome_do_pet}}</td>
                <td>{{servico}}</td>
            </tr>
            {{{/each}}}
        </tbody>
    </table>
</section>
</table>
</table>