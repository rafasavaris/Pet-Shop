<div class="widget">
    <div class="config-agenda-header">
        <h1>Configuração da Agenda</h1>
        {{#if salvo}}
            <p>Configuração da agenda salva com sucesso!</p>
        {{else}}
            {{#if erro}}
                <p class="erro">Não é possível reduzir a capacidade de um horário que já possui agendamentos.</p>
            {{/if}}
        {{/if}}
    </div>
<form action="/ajustaPetAgenda" method="POST" class="form">
    <table>
        <thead>
            <tr>
                <th>Horário</th>
                <th>Segunda</th>
                <th>Terça</th>
                <th>Quarta</th>
                <th>Quinta</th>
                <th>Sexta</th>
                <th>Sábado</th>
            </tr>
        </thead>

        <tbody>
            {{#each configuracoes}}
            <tr>
                <td>{{horario}}:00</td>
                <td><input type="number" name="seg{{horario}}" min="0" value="{{segunda}}"></td>
                <td><input type="number" name="ter{{horario}}" min="0" value="{{terca}}"></td>
                <td><input type="number" name="qua{{horario}}" min="0" value="{{quarta}}"></td>
                <td><input type="number" name="qui{{horario}}" min="0" value="{{quinta}}"></td>
                <td><input type="number" name="sex{{horario}}" min="0" value="{{sexta}}"></td>
                <td><input type="number" name="sab{{horario}}" min="0" value="{{sabado}}"></td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    <button type="submit">Salvar configurações</button>
</form>
    <nav class="admin-nav">
        <a class="admin-link" href="/admin">
            Voltar para a área administrativa
        </a>
    </nav>
<div>