<!DOCTYPE html>
<html lang="pt-br">
    <head>
        <meta charset="UTF-8">
        <title>Agendamento</title>
        <link rel="stylesheet" href="/css/style.css">
    </head>
    <body>
        <section class="agendamento">
        <div class="agendamento-header">
            <h1>Agendamento de Banho e Tosa</h1>
            <p>Agende seu serviço de banho e tosa para o seu pet</p>
        </div>
        <form class = "agendamento-form" action="/agendamento" method="POST">
            <div class="campo">
                <label for="nome">Nome:</label>
                <input type="text" name="nome" placeholder="Digite seu nome">
            </div>
            <div class="campo">
                <label for="telefone">Telefone:</label>
                <input type="text" name="telefone" placeholder="Digite seu telefone">
            </div>
            <div class="campo">
                <label for="endereco">Endereço:</label>
                <input type="text" name="endereco" placeholder="Digite seu endereço">
            </div>
            <div class="campo">
                <label for="nome_do_pet">Nome do Pet:</label>
                <input type="text" name="nome_do_pet" placeholder="Digite o nome do seu pet">
            </div>
            <div class="campo">
                <label for="data">Data:</label>
                <input type="date" name="data">
            </div>
            <div class="campo">
                <label for="hora">Hora:</label>
                <input type="time" name="hora">
            </div>
            <div class="campo">
                <label for="servico">Serviço:</label>
                <select name="servico">
                    <option value="banho">Banho</option>
                    <option value="tosa">Tosa</option>
                    <option value="banho+tosa">Banho + Tosa</option>
                </select>
            </div>
            <div>
                <button type="submit">Agendar</button>
            </div>

        </form>
        </section>
        
        
    </body>